{
  "name": "@launch/ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch",
    "lint": "biome check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --root ../.. run packages/ui-web/src/index.test.tsx"
  },
  "dependencies": {
    "@launch/design-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^19.2.4"
  }
}
