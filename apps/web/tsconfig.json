{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      // Typed facade over the generated Convex API — see the header
      // comment in lib/convex-generated-api.ts for why. Runtime behavior
      // is identical (both export Convex's anyApi proxy).
      "@launch/convex/_generated/api": ["./lib/convex-generated-api.ts"],
      "@launch/ai": ["../../packages/ai/src/index.ts"],
      "@launch/analytics": ["../../packages/analytics/src/index.ts"],
      "@launch/auth": ["../../packages/auth/src/index.ts"],
      "@launch/billing": ["../../packages/billing/src/index.ts"],
      "@launch/config": ["../../packages/config/src/index.ts"],
      "@launch/config/product": ["../../packages/config/src/product.ts"],
      "@launch/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@launch/domain": ["../../packages/domain/src/index.ts"],
      "@launch/storage": ["../../packages/storage/src/index.ts"],
      "@launch/ui-native": ["../../packages/ui-native/src/index.tsx"],
      "@launch/ui-web": ["../../packages/ui-web/src/index.tsx"]
    },
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mdx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
