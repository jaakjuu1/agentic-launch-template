# Next.js app env. Copy to apps/web/.env.local.
# The site builds and runs with none of these set (marketing pages only);
# /operator needs the Clerk + Convex values.

# Convex deployment URL (printed by `pnpm --filter @launch/convex dev`).
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard → API keys). Both required for /operator + /sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe — used when you add the checkout route (docs/integrations.md).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO_MONTHLY=

# Optional observability/email.
NEXT_PUBLIC_POSTHOG_KEY=
RESEND_API_KEY=
SENTRY_DSN=
