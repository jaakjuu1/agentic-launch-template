# Convex deployment environment variables.
# Set these with `npx convex env set NAME value` (or the Convex dashboard) —
# Convex functions read the deployment env, not this file. For local dev,
# `npx convex dev` also picks up convex/.env.local.

# --- Development convenience ------------------------------------------------
# DEMO_MODE=true lets unauthenticated callers act as a shared demo viewer,
# enables demo seed data and the grantPreviewPro shortcut.
# NEVER set this on a production deployment.
DEMO_MODE=true

# --- Auth (Clerk) -----------------------------------------------------------
# Frontend API URL of your Clerk instance (Clerk dashboard → API keys),
# e.g. https://verb-noun-00.clerk.accounts.dev — required for real sign-in.
CLERK_JWT_ISSUER_DOMAIN=
# Signing secret of the Clerk webhook endpoint (Clerk dashboard → Webhooks).
CLERK_WEBHOOK_SECRET=

# --- AI ---------------------------------------------------------------------
# Enables real artifact generation, chat, and embeddings.
OPENAI_API_KEY=
# Optional overrides; defaults come from packages/config/src/product.ts and
# convex/lib/env.ts. Embedding model output size must match
# EMBEDDING_DIMENSIONS in convex/lib/env.ts.
AI_MODEL=
AI_EMBEDDING_MODEL=

# --- Billing ----------------------------------------------------------------
# Stripe webhook endpoint signing secret (Stripe dashboard → Webhooks).
STRIPE_WEBHOOK_SECRET=
# Value you configure as the Authorization header in the RevenueCat
# webhook settings; requests must match it exactly.
REVENUECAT_WEBHOOK_AUTH_TOKEN=

# --- File storage (Cloudflare R2) -------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=104857600
# Origins allowed to PUT directly to R2 — configure the same list as CORS
# rules on the bucket (see docs/integrations.md).
R2_ALLOWED_WEB_ORIGINS=http://localhost:8081,http://localhost:3000

# --- Email + observability (optional) ---------------------------------------
RESEND_API_KEY=
# Signing secret for the Resend webhook endpoint (Svix scheme).
RESEND_WEBHOOK_SECRET=
POSTHOG_PROJECT_API_KEY=
SENTRY_DSN=
