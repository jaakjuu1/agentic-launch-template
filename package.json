{
  "name": "agentic-launch-template",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "bs58": "^6.0.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "codegen": "pnpm --filter @launch/convex codegen",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "biome check --write .",
    "new-product": "tsx scripts/new-product.ts",
    "clean": "git clean -xfd node_modules .turbo dist coverage .next"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@playwright/test": "^1.58.2",
    "@ai-sdk/openai": "^2.0.57",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "convex": "^1.33.1",
    "tsup": "^8.5.1",
    "turbo": "^2.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
