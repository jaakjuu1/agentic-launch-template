# Expo app env. Copy to apps/product/.env.local.
#
# The app derives its mode from what is set here:
#   nothing set                → offline demo (bundled fixtures)
#   CONVEX_URL only            → live demo (deployment needs DEMO_MODE=true)
#   CONVEX_URL + CLERK key     → real accounts

# Convex deployment URL (printed by `pnpm --filter @launch/convex dev`).
EXPO_PUBLIC_CONVEX_URL=

# Clerk publishable key (Clerk dashboard → API keys).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional — wired in Phase 4/6 of docs/ROADMAP.md.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
