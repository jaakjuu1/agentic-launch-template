{
  "name": "@launch/ui-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch",
    "lint": "biome check src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --root ../.. run --passWithNoTests packages/ui-native/src/index.test.tsx"
  },
  "dependencies": {
    "@launch/design-tokens": "workspace:*",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react-native": "^1.35.0",
    "nativewind": "^4.2.2",
    "react": "^19.2.4",
    "react-native": "^0.84.1",
    "react-native-reanimated": "^4.2.2",
    "react-native-screens": "^4.24.0",
    "tailwind-merge": "^3.6.0"
  }
}
