# Workspace-level variables. App- and backend-specific env lives next to
# each surface — copy each example to a .env.local (or set on the platform):
#
#   apps/product/.env.example -> apps/product/.env.local  (Expo)
#   apps/web/.env.example     -> apps/web/.env.local      (Next.js)
#   convex/.env.example       -> `npx convex env set ...` (Convex deployment)
#
# See docs/integrations.md for where every value comes from.

# Used by `npx convex dev` / CI deploys of the backend.
CONVEX_DEPLOYMENT=

# Playwright e2e target override; when unset, the suite boots a local
# production build of apps/web.
E2E_BASE_URL=

# Release tooling (optional until you ship).
EXPO_TOKEN=
SENTRY_AUTH_TOKEN=
